    if not requestFunc then
        loadingLabel.Text = "❌ Error: Executor does not support HTTP requests!"
        return
    end

    local function fetchCollection(colName)
        local success, res = pcall(function()
            return requestFunc({ Url = "https://ps99.biggamesapi.io/api/collection/" .. colName, Method = "GET" })
        end)
        if success and res and res.Body then
            local decoded = HttpService:JSONDecode(res.Body)
            if decoded and decoded.data then return decoded.data end
        end
        return {}
    end

