local function saveData(gemsTotal, itemsList, visualState)
    if writefile then
        local success, encoded = pcall(function()
            return HttpService:JSONEncode({
                Gems = gemsTotal,
                Items = itemsList,
                VisualsEnabled = visualState
            })
        end)
        if success then writefile(saveFilePath, encoded) end
    end
end

local function loadSavedData()
    if readfile and isfile and isfile(saveFilePath) then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(saveFilePath))
        end)
        if success and type(decoded) == "table" then
            local vState = false
            if decoded.VisualsEnabled ~= nil then vState = decoded.VisualsEnabled end
            return decoded.Gems or 0, decoded.Items or {}, vState
        end
    end
    return 0, {}, false
end

