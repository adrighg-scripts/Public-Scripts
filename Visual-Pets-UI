local lastInventorySignature = ""
local function getInventorySignature()
    if not addedItemsInventory then return "" end
    local sig = ""
    for _, item in ipairs(addedItemsInventory) do
        if item.Category == "Pets" then
            sig = sig .. item.Name .. "_" .. tostring(item.Amount) .. "_" .. tostring(item.Version) .. "_" .. tostring(item.Shiny) .. "_"
        end
    end
    return sig
end

task.spawn(function()
    while screenGui and screenGui.Parent do
        local currentSig = getInventorySignature()
        if currentSig ~= lastInventorySignature then
            lastInventorySignature = currentSig
            refreshAllVisualPetsInWorkspace()
            injectVisualPetsIntoGameInventory()
        end
        task.wait(0.5)
    end
end)

