local function updateSubTabs()
    for _, child in ipairs(subCatFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    subTabButtons = {}

    local listToUse = (currentMainCategory == "Added Visuals") and addedVisualSubCategories or petSubCategories
    local totalTabs = #listToUse
    local totalWidth = 636
    
    local tabWidth = math.floor(totalWidth / totalTabs) - 4
    if currentMainCategory == "Pets" then tabWidth = math.floor(totalWidth / 4) - 4 end
    local spacing = (totalTabs > 1) and ((totalWidth - (tabWidth * totalTabs)) / (totalTabs - 1)) or 0

    for i, subName in ipairs(listToUse) do
        local activeSub = (currentMainCategory == "Added Visuals") and currentVisualSubCategory or currentPetSubCategory

        local subBtn = Instance.new("TextButton")
        subBtn.Size = UDim2.new(0, tabWidth, 0, 30)
        subBtn.Position = UDim2.new(0, math.floor((i - 1) * (tabWidth + spacing)), 0, 0)
        subBtn.BackgroundColor3 = (subName == activeSub) and Color3.fromRGB(255, 120, 40) or Color3.fromRGB(160, 160, 160)
        subBtn.BackgroundTransparency = 0.2
        subBtn.BorderSizePixel = 0
        subBtn.Font = Enum.Font.FredokaOne
        subBtn.Text = subName
        subBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        subBtn.TextSize = 11
        subBtn.Parent = subCatFrame

        Instance.new("UICorner", subBtn).CornerRadius = UDim.new(0, 8)
        subTabButtons[subName] = subBtn

        subBtn.MouseButton1Click:Connect(function()
            local activeKey = currentMainCategory .. "_" .. ((currentMainCategory == "Added Visuals") and currentVisualSubCategory or currentPetSubCategory)
            scrollPositions[activeKey] = contentGrid.CanvasPosition.Y

            if currentMainCategory == "Added Visuals" then
                currentVisualSubCategory = subName
                lastSubCategoryPerMain["Added Visuals"] = subName
            else
                currentPetSubCategory = subName
                lastSubCategoryPerMain["Pets"] = subName
            end

            updateSubTabs()
            refreshGrid()

            local newActiveKey = currentMainCategory .. "_" .. ((currentMainCategory == "Added Visuals") and currentVisualSubCategory or currentPetSubCategory)
            if subName == "Pets" and currentMainCategory == "Pets" then
                contentGrid.CanvasPosition = Vector2.new(0, 0)
                scrollPositions[newActiveKey] = 0
            else
                contentGrid.CanvasPosition = Vector2.new(0, scrollPositions[newActiveKey] or 0)
            end
        end)
    end
end

