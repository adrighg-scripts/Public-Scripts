-- Erstellt die Shiny-Effekte mit spezifischen Keypoints je nach Pet-Typ
local function applyShinyEffects(clonedModel, subCat)
    if not clonedModel then return end

    local sizeSequence
    local subCatLower = string.lower(subCat or "")
    
    if string.find(subCatLower, "gargantuan") then
        sizeSequence = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0, 0),
            NumberSequenceKeypoint.new(0.169133, 34.436125, 0),
            NumberSequenceKeypoint.new(0.411205, 40.028375, 0),
            NumberSequenceKeypoint.new(1, 47.38650, 0)
        })
    elseif string.find(subCatLower, "titanic") then
        sizeSequence = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0, 0),
            NumberSequenceKeypoint.new(0.169133, 13.77445, 0),
            NumberSequenceKeypoint.new(0.411205, 16.01135, 0),
            NumberSequenceKeypoint.new(1, 18.95460, 0)
        })
    elseif string.find(subCatLower, "huge") then
        sizeSequence = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0, 0),
            NumberSequenceKeypoint.new(0.169133, 5.50978, 0),
            NumberSequenceKeypoint.new(0.411205, 6.40454, 0),
            NumberSequenceKeypoint.new(1, 7.58184, 0)
        })
    else
        sizeSequence = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0, 0),
            NumberSequenceKeypoint.new(0.169133, 2.20391, 0),
            NumberSequenceKeypoint.new(0.411205, 2.56181, 0),
            NumberSequenceKeypoint.new(1, 3.03274, 0)
        })
    end

    local targetParts = clonedModel:IsA("BasePart") and {clonedModel} or clonedModel:GetDescendants()
    
    for _, part in ipairs(targetParts) do
        if part:IsA("BasePart") then
            if not part:FindFirstChild("ShinyTrail") then
                pcall(function()
                    local trail = Instance.new("Trail")
                    trail.Name = "ShinyTrail"
                    trail.Enabled = true
                    trail.LightInfluence = 0
                    trail.LightEmission = 1
                    trail.Brightness = 10
                    trail.Lifetime = 0.5
                    trail.Texture = ""
                    trail.Parent = part
                end)
            end
            
            local centerAtt = part:FindFirstChild("center")
            if not centerAtt or not centerAtt:IsA("Attachment") then
                pcall(function()
                    centerAtt = Instance.new("Attachment")
                    centerAtt.Name = "center"
                    centerAtt.Position = Vector3.new(0, 0, 0)
                    centerAtt.Parent = part
                end)
            end
            
            if centerAtt and not centerAtt:FindFirstChild("Shiny") then
                pcall(function()
                    local shinyEmitter = Instance.new("ParticleEmitter")
                    shinyEmitter.Name = "Shiny"
                    shinyEmitter.Texture = "rbxassetid://16412400324"
                    shinyEmitter.Brightness = 10
                    shinyEmitter.Rate = 6.5
                    shinyEmitter.Lifetime = NumberRange.new(1, 1.5)
                    shinyEmitter.Speed = NumberRange.new(0.002)
                    shinyEmitter.Rotation = NumberRange.new(-360, 360)
                    shinyEmitter.ZOffset = 0.96
                    shinyEmitter.LightEmission = 1
                    shinyEmitter.LightInfluence = 0
                    shinyEmitter.Orientation = Enum.ParticleOrientation.FacingCamera
                    shinyEmitter.Enabled = true
                    shinyEmitter.Size = sizeSequence
                    shinyEmitter.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1, 0),
                        NumberSequenceKeypoint.new(0.099, 1, 0),
                        NumberSequenceKeypoint.new(0.5, 0.732),
                        NumberSequenceKeypoint.new(1, 0, 0)
                    })
                    shinyEmitter:SetAttribute("EmitCount", 6)
                    shinyEmitter.Parent = centerAtt
                end)
            end
        end
    end
end

-- Erstellt den Rainbow-Stil
local function applyCustomRainbowStyle(rootInstance, isShiny)
    local targetParts = rootInstance:IsA("BasePart") and {rootInstance} or rootInstance:GetDescendants()
    local rainbowTransparency = isShiny and 0.85 or 0.5
    
    for _, part in ipairs(targetParts) do
        if part:IsA("BasePart") then
            for _, child in ipairs(part:GetChildren()) do
                if child:IsA("SurfaceAppearance") then
                    child:Destroy()
                end
            end
            
            local faces = {
                Enum.NormalId.Top, Enum.NormalId.Bottom, 
                Enum.NormalId.Left, Enum.NormalId.Right, 
                Enum.NormalId.Front, Enum.NormalId.Back
            }
            
            for _, face in ipairs(faces) do
                pcall(function()
                    local decal = Instance.new("Decal")
                    decal.Name = "__RAINBOWFX"
                    decal.Texture = "rbxassetid://4615292350"
                    decal.Face = face
                    decal.Transparency = rainbowTransparency
                    decal.ZIndex = 10
                    decal.Parent = part
                    
                    table.insert(activeRainbowEffects, decal)
                end)
            end
        end
    end
end

