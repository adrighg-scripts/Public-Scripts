local function formatNumberAbbreviated(val)
    if not val then return "0" end
    local absVal = math.abs(val)
    
    if absVal >= 1010 then
        if absVal >= 1000000000000000 then return string.format("%.2fq", val / 1000000000000000)
        elseif absVal >= 1000000000000 then return string.format("%.2ft", val / 1000000000000)
        elseif absVal >= 1000000000 then return string.format("%.2fb", val / 1000000000)
        elseif absVal >= 1000000 then return string.format("%.2fm", val / 1000000)
        elseif absVal >= 1000 then return string.format("%.2fk", val / 1000) end
    end
    
    local formattedInt = ""
    local rev = string.reverse(tostring(math.floor(absVal)))
    for i = 1, #rev do
        formattedInt = formattedInt .. rev:sub(i, i)
        if i % 3 == 0 and i ~= #rev then formattedInt = formattedInt .. "," end
    end
    formattedInt = string.reverse(formattedInt)
    if val < 0 then formattedInt = "-" .. formattedInt end
    return formattedInt
end

local function formatWithBracket(val)
    if not val then val = 0 end
    local formattedInt = ""
    local rev = string.reverse(tostring(math.floor(val)))
    for i = 1, #rev do
        formattedInt = formattedInt .. rev:sub(i, i)
        if i % 3 == 0 and i ~= #rev then formattedInt = formattedInt .. "," end
    end
    formattedInt = string.reverse(formattedInt)
    return string.format("%s (%s)", formattedInt, formatNumberAbbreviated(val))
end

