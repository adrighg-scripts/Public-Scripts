local function parseInputWithSuffix(text)
    if not text then return 0 end
    text = string.lower(text):gsub(",", "."):gsub("%s+", " ")
    local totalSum = 0
    local foundAny = false

    for numStr, suffix in text:gmatch("([0-9%.]+)%s*([kmgtqb]b?)") do
        local num = tonumber(numStr)
        if num then
            foundAny = true
            local multiplier = 1
            if suffix == "k" then multiplier = 1000
            elseif suffix == "m" then multiplier = 1000000
            elseif suffix == "b" or suffix == "gb" then multiplier = 1000000000
            elseif suffix == "t" or suffix == "tb" then multiplier = 1000000000000
            elseif suffix == "q" or suffix == "qb" then multiplier = 1000000000000000 end
            totalSum = totalSum + (num * multiplier)
        end
    end
    if foundAny then return totalSum end

    local pureSum = 0
    for part in text:gmatch("%S+") do
        local num = tonumber(part)
        if num then pureSum = pureSum + num end
    end
    return pureSum
end

