-- Hilfsfunktion: Setzt Kollisionen aus, fixiert die Teile, damit sie nicht durchfallen
local function setupPetModelPhysics(model)
    if not model then return end
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.CanCollide = false
            desc.CanQuery = false
            desc.CanTouch = false
            desc.Anchored = true 
        end
    end
end

-- Funktion zur Ermittlung der korrekten Star-ID je nach Pet-Typ und Rarity
local function getStarId(subCat, itemName, rarity)
    local subCatLower = string.lower(subCat or "")
    local nameLower = string.lower(itemName or "")
    local rarityLower = string.lower(rarity or "")

    if string.find(subCatLower, "huge") or string.find(nameLower, "huge") then
        return "rbxassetid://17846631169"
    elseif string.find(subCatLower, "titanic") or string.find(nameLower, "titanic") then
        return "rbxassetid://15200206892"
    elseif string.find(subCatLower, "gargantuan") or string.find(nameLower, "gargantuan") then
        return "rbxassetid://107212846292795"
    elseif string.find(subCatLower, "exclusive") or string.find(nameLower, "exclusive") then
        return "rbxassetid://17846631605"
    else
        local rarities = {
            ["rare"] = "rbxassetid://15211278088",
            ["epic"] = "rbxassetid://15211277885",
            ["legendary"] = "rbxassetid://15200207030",
            ["mythical"] = "rbxassetid://16334437303",
            ["exotic"] = "rbxassetid://16334437019",
            ["devine"] = "rbxassetid://16334436751",
            ["superior"] = "rbxassetid://16334437151",
            ["celestial"] = "rbxassetid://16334436886"
        }
        return rarities[rarityLower] or "rbxassetid://15211278088"
    end
end

