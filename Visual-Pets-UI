local function spawnVisualPetModel(itemData)
    if not petsDirectory then return nil end
    
    local subFolderName = "Uncategorized"
    local subCat = itemData.SubCategory
    
    if subCat == "Gargantuans" then subFolderName = "Gargantuan"
    elseif subCat == "Titanics" then subFolderName = "Titanic"
    elseif subCat == "Huges" then subFolderName = "Huge" end
    
    local targetFolder = petsDirectory:FindFirstChild(subFolderName) or petsDirectory:FindFirstChild("Uncategorized") or petsDirectory
    local template = targetFolder:FindFirstChild(itemData.Name)
    
    if not template and #targetFolder:GetChildren() > 0 then
        template = targetFolder:GetChildren()[1]
    end
    
    if not template then return nil end
    
    local variantSource = nil
    local version = tostring(itemData.Version or "Normal")
    local versionLower = string.lower(version)
    local itemNameLower = string.lower(itemData.Name or "")
    
    local isRainbowType = string.find(versionLower, "rainbow") ~= nil or string.find(itemNameLower, "rainbow") ~= nil
    local isGoldType = string.find(versionLower, "gold") ~= nil or string.find(versionLower, "golden") ~= nil or string.find(itemNameLower, "gold") ~= nil
    local isShinyType = (itemData.Shiny == true) or (string.find(versionLower, "shiny") ~= nil) or (string.find(itemNameLower, "shiny") ~= nil)
    
    if isGoldType then
        variantSource = template:FindFirstChild("Golden") or template:FindFirstChild("Gold") or template:FindFirstChild("Gold Shiny")
    elseif isRainbowType then
        variantSource = template:FindFirstChild("Rainbow") or template:FindFirstChild("Shiny Rainbow") or template:FindFirstChild("Pet")
    else
        variantSource = template:FindFirstChild("Pet") or template:FindFirstChild("Normal")
    end
    
    if not variantSource then variantSource = template:FindFirstChildWhichIsA("Folder", true) or template end
    if variantSource and variantSource:IsA("Folder") then
        variantSource = variantSource:FindFirstChildWhichIsA("BasePart", true) or variantSource:FindFirstChildWhichIsA("Model", true)
    end
    if not variantSource then variantSource = template end
    
    local successClone, clonedPart = pcall(function() return variantSource:Clone() end)
    if not successClone or not clonedPart then return nil end
    
    local petId = tostring(math.random(100000, 999999))
    local newPetModel = Instance.new("Model")
    newPetModel.Name = petId
    
    clonedPart.Name = petId
    clonedPart.Parent = newPetModel
    
    if isRainbowType then applyCustomRainbowStyle(newPetModel, isShinyType) end
    if isShinyType then applyShinyEffects(newPetModel, subCat) end
    
    setupPetModelPhysics(newPetModel)
    
    if clonedPart:IsA("BasePart") then newPetModel.PrimaryPart = clonedPart
    else
        local p = clonedPart:FindFirstChildWhichIsA("BasePart", true)
        if p then newPetModel.PrimaryPart = p end
    end
    
    local thingsFolder = Workspace:WaitForChild("__THINGS", 5)
    local workspacePets = thingsFolder and thingsFolder:WaitForChild("Pets", 5)
    newPetModel.Parent = workspacePets or Workspace
    
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local charRoot = player.Character.HumanoidRootPart
        local randomOffset = Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))
        local spawnCFrame = charRoot.CFrame + (charRoot.CFrame.LookVector * 5) + randomOffset + Vector3.new(0, 2, 0)
        if newPetModel.PrimaryPart then newPetModel:SetPrimaryPartCFrame(spawnCFrame) end
    end
    
    return newPetModel
end

refreshAllVisualPetsInWorkspace = function()
    clearAllVisualPetsFromWorkspace()
    if not visualGemsEnabled or not addedItemsInventory then return end
    
    for _, item in ipairs(addedItemsInventory) do
        if item.Category == "Pets" then
            local subCatCheck = string.lower(item.SubCategory or "")
            local isTitanicOrGargantuan = (subCatCheck == "titanics" or string.find(subCatCheck, "titanic") or subCatCheck == "gargantuans" or string.find(subCatCheck, "gargantuan"))
            
            local spawnCount = 1
            if isTitanicOrGargantuan then
                spawnCount = item.Amount or 1
            else
                spawnCount = math.min(item.Amount or 1, 10)
            end
            
            for i = 1, spawnCount do
                local spawnedModel = spawnVisualPetModel(item)
                if spawnedModel then table.insert(spawnedVisualPetInstances, spawnedModel) end
            end
        end
    end
end

injectVisualPetsIntoGameInventory = function()
    local inventoryFrame = playerGui:FindFirstChild("Inventory")
    local mainPetsContainer = inventoryFrame and inventoryFrame:FindFirstChild("Frame") and inventoryFrame.Frame:FindFirstChild("Main") and inventoryFrame.Frame.Main:FindFirstChild("Pets")
    
    if not mainPetsContainer then return end

    for _, child in ipairs(mainPetsContainer:GetChildren()) do
        if child:GetAttribute("InjectedVisualPet") == true then
            child:Destroy()
        end
    end

    if not visualGemsEnabled or not addedItemsInventory then return end

    for _, item in ipairs(addedItemsInventory) do
        if item.Category == "Pets" then
            local targetFolder = mainPetsContainer
            local subCatLowerCheck = string.lower(item.SubCategory or "")
            
            if subCatLowerCheck == "titanics" or string.find(subCatLowerCheck, "titanic") then
                targetFolder = mainPetsContainer:FindFirstChild("PetsTitanic") or mainPetsContainer
            elseif subCatLowerCheck == "gargantuans" or string.find(subCatLowerCheck, "gargantuan") then
                targetFolder = mainPetsContainer:FindFirstChild("PetsGargantuan") or mainPetsContainer
            else
                targetFolder = mainPetsContainer:FindFirstChild("Pets") or mainPetsContainer
            end

            local templateSource = targetFolder:GetChildren()[5] or targetFolder:FindFirstChildWhichIsA("Frame")
            
            local totalCount = item.Amount or 1
            local isHugeOrHigherCheck = string.find(subCatLowerCheck, "huge") or string.find(subCatLowerCheck, "titanic") or string.find(subCatLowerCheck, "gargantuan")
            
            local loops = isHugeOrHigherCheck and totalCount or 1

            for i = 1, loops do
                local card
                if templateSource then
                    card = templateSource:Clone()
                    card.Name = "ItemSlot"
                    card.Parent = targetFolder
                else
                    card = Instance.new("TextButton")
                    card.Name = "ItemSlot"
                    card.Parent = targetFolder
                end

                setupPetSlot(card, templateSource, item)
                card:SetAttribute("InjectedVisualPet", true)
                card.Visible = true

                for _, desc in ipairs(card:GetDescendants()) do
                    if desc:IsA("TextButton") or desc:IsA("ImageButton") then
                        desc.Active = true
                    end
                end
            end
        end
    end
end

