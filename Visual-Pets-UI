    local function getThumbnail(configData)
        if configData and configData.thumbnail then
            local thumb = tostring(configData.thumbnail)
            if string.find(thumb, "rbxassetid://") then return thumb
            elseif tonumber(thumb) then return "rbxassetid://" .. thumb end
        end
        return "rbxassetid://0"
    end

    for _, entry in ipairs(petsData) do
        local config = entry.configData or {}
        local name = config.name or entry.configName or "Unknown Pet"
        local goldenThumb = "rbxassetid://0"
        if config.goldenThumbnail and config.goldenThumbnail ~= "" then
            local gt = tostring(config.goldenThumbnail)
            if string.find(gt, "rbxassetid://") then goldenThumb = gt
            elseif tonumber(gt) then goldenThumb = "rbxassetid://" .. gt end
        end
        local petItem = { Name = name, Icon = getThumbnail(config), GoldenIcon = goldenThumb }

        local catLower = string.lower(entry.category or "")
        local nameLower = string.lower(name)

        if string.find(nameLower, "gargantuan") then table.insert(masterDatabase.Pets.Gargantuans, petItem)
        elseif string.find(nameLower, "titanic") or catLower == "titanic" then table.insert(masterDatabase.Pets.Titanics, petItem)
        elseif string.find(nameLower, "huge") or catLower == "huge" or config.huge then table.insert(masterDatabase.Pets.Huges, petItem)
        else table.insert(masterDatabase.Pets.Pets, petItem) end
    end

    loadingLabel:Destroy()
    updateSubTabs()
    refreshGrid()
end)

searchBox:GetPropertyChangedSignal("Text"):Connect(refreshGrid)

